  <diagram name="Class Diagram" id="q6hx4ECEvkHKw4Ns7pEx">
    <mxGraphModel dx="3920" dy="2007" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class ChatController {\n        +createSession(payload: Map) : ResponseEntity\n        +getMessagess(sessionId: Long) : ResponseEntity\n        +deleteSession(sessionId: Long) : ResponseEntity\n        +askQuestion(sessionId: Long, payload: Map) : ResponseEntity\n        +askQuestionGeneric(payload: Map) : ResponseEntity\n    }\n\n    class ChatService {\n        +askQuestion(sessionId: Long, question: String, mode: String, subject: String, localEndpoint: String) : String\n    }\n\n    class ChatMessageRepository {\n        &lt;&lt;interface&gt;&gt;\n        +findBySessionIdOrderByCreatedAtAsc(sessionId: Long) : List\n    }\n\n    class ChatMessage {\n        -id : Long\n        -session : ChatSession\n        -role : String\n        -content : String\n        -createdAt : LocalDateTime\n        #onCreate() : void\n    }\n\n    class ChatSession {\n        -id : Long\n        -title : String\n        -createdAt : LocalDateTime\n        -messages : List\n        #onCreate() : void\n    }\n\n    class ChatSessionRepository {\n        &lt;&lt;interface&gt;&gt;\n    }\n\n    class FineTuningController {\n        +generateScript(request: FineTuningRequest) : ResponseEntity\n    }\n\n    class FineTuningRequest {\n        -modelName : String\n        -loraR : int\n        -loraAlpha : int\n        -epochs : int\n        -datasetName : String\n    }\n\n    class FineTuningService {\n        +generatePythonScript(modelName: String, loraR: int, loraAlpha: int, epochs: int, datasetName: String) : String\n    }\n\n    class CourseDocumentRepository {\n        &lt;&lt;interface&gt;&gt;\n    }\n\n    class CourseDocument {\n        -id : Long\n        -filename : String\n        -subject : String\n        -chapter : String\n        -uploadDate : LocalDateTime\n        -status : String\n    }\n\n    class DocumentController {\n        +uploadDocument(file: MultipartFile, subject: String, chapter: String) : ResponseEntity\n        +getAllDocuments() : ResponseEntity\n        +deleteDocument(id: Long) : ResponseEntity\n    }\n\n    class DocumentService {\n        +uploadAndIndex(file: MultipartFile, subject: String, chapter: String) : CourseDocument\n        +getAllDocuments() : List\n        +deleteDocument(id: Long) : void\n    }\n\n    %% Relationships\n    ChatController \&quot;1\&quot; --&gt; \&quot;1\&quot; ChatService : uses\n    ChatService \&quot;1\&quot; --&gt; \&quot;1\&quot; ChatMessageRepository : uses\n    ChatService \&quot;1\&quot; --&gt; \&quot;1\&quot; ChatSessionRepository : uses\n    ChatMessageRepository \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ChatMessage : manages\n    ChatSessionRepository \&quot;1\&quot; --&gt; \&quot;1\&quot; ChatSession : manages\n    ChatSession \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ChatMessage : contains\n\n    FineTuningController \&quot;1\&quot; --&gt; \&quot;1\&quot; FineTuningService : uses\n    FineTuningController \&quot;1\&quot; --&gt; \&quot;1\&quot; FineTuningRequest : uses\n    FineTuningService \&quot;1\&quot; --&gt; \&quot;1\&quot; CourseDocumentRepository : uses\n\n    DocumentController \&quot;1\&quot; --&gt; \&quot;1\&quot; DocumentService : uses\n    DocumentService \&quot;1\&quot; --&gt; \&quot;1\&quot; CourseDocumentRepository : uses\n    DocumentService \&quot;1\&quot; --&gt; \&quot;1\&quot; CourseDocument : manages\n\n    CourseDocumentRepository \&quot;1\&quot; --&gt; \&quot;1\&quot; CourseDocument : manages\n\n    %% Styling (Ép màu trắng viền đen)\n    classDef whiteBox fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000;\n    class ChatController,ChatService,ChatMessageRepository,ChatMessage,ChatSession,ChatSessionRepository,FineTuningController,FineTuningRequest,FineTuningService,CourseDocumentRepository,CourseDocument,DocumentController,DocumentService whiteBox;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ounxh0WJ1CDWAgRrEq_b-414">
